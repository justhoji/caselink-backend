PORT=3000

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=caselink_db
DB_SYNCHRONIZE=true
DB_LOGGING=true

# JWT Secrets & Expirations
JWT_STAFF_SECRET=super-secret-staff-key-change-in-prod
JWT_CLIENT_SECRET=super-secret-client-key-change-in-prod
JWT_ACCESS_EXPIRATION=15m
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION=7d
JWT_REFRESH_EXPIRATION_DAYS=7

# Auth Security & OTP Rules
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
OTP_COOLDOWN_SECONDS=60
OTP_EXPIRATION_MINUTES=5

# Google (Gmail / Google Workspace) SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-google-email@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM="Caselink <your-google-email@gmail.com>"

# Company SMS Gateway Configuration (http://10.1.1.97:3000/en/)
SMS_GATEWAY_URL=http://10.1.1.97:3000/api/v2
SMS_API_KEY=your-api-key-here
SMS_API_SECRET=your-api-secret-here
SMS_TEMPLATE_ID=10
