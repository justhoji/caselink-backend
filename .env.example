PORT=3000

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=caselink_db
DB_SYNCHRONIZE=false
DB_LOGGING=true

# JWT Secrets & Expirations
# JWT_STAFF_SECRET must be at least 32 characters — app will refuse to start without it
JWT_STAFF_SECRET=change-me-to-a-random-secret-min-32-chars
JWT_CLIENT_SECRET=change-me-to-a-random-secret-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION=7d
JWT_REFRESH_EXPIRATION_DAYS=7

# Auth Security & OTP Rules
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
OTP_COOLDOWN_SECONDS=60
OTP_EXPIRATION_MINUTES=5

# Rate Limiting (TTL in milliseconds)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
